# Local development environment for Mirza Bot (Cloud Agent).
# Copied to repo-root .env by .cursor/install.sh if no .env exists.
# Contains NO real secrets — bot tokens and external API keys are intentionally
# omitted so the gateway boots as a thin client against local MongoDB + Redis.

# PROJECT_NAME must be space-free: it is used verbatim as the MongoDB database name.
PROJECT_NAME=mirza-bot
DOMAIN=localhost
PORT=8000

DEBUG=1
MONGO_URI=mongodb://localhost:27017/
REDIS_URI=redis://localhost:6379

CORS_ORIGINS='["http://localhost:8000"]'
JWT_CONFIG='{"jwks_url":"https://usso.uln.me/.well-known/jwks.json"}'

USSO_BASE_URL=https://usso.uln.me
USSO_NAMESPACE=ai

# Shared secret for inbound AI/Bale webhooks (fail-closed if unset).
WEBHOOK_API_KEY=local-dev-webhook-key

# Bale getUpdates long-poll sleep interval.
POLLING_INTERVAL_SECONDS=2

# Telegram/Bale adapters are skipped while their tokens are unset. To exercise a
# live bot, add TELEGRAM_TOKEN (+ TELEGRAM_API_ID/TELEGRAM_API_HASH) or BALE_BOT_TOKEN.
